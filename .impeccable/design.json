    },
    {
      "name": "Outlined Button (kraft)",
      "kind": "button",
      "refersTo": "button-line-on-kraft",
      "description": "Secondary pill on kraft; rust focus ring.",
      "html": "<div class=\"ds-root ds-kraft\"><a class=\"ds-btn ds-btn-kl\" href=\"#\">See me on Facebook</a></div>",
