    {
      "name": "Filled Button",
      "kind": "button",
      "refersTo": "button-fill",
      "description": "Primary pill; always opens a text to Ian.",
      "html": "<div class=\"ds-root ds-dark\"><a class=\"ds-btn ds-btn-fill\" href=\"#\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.6 3.8c-.5.4-1.4.1-1.4-.6V5.5Z\" fill=\"currentColor\"/></svg>Text for a free estimate</a></div>",
      "css": ":host,.ds-root{--pine:#183a2c;--night:#132d23;--deep:#10261d;--kraft:#e6d2aa;--bark:#2b1d12;--bark-2:#5b4330;--cream:#f6ecd8;--sage:#c3d5c1;--rust:#b8441e;--rust-hi:#9e3615;--gold:#f2bf45;--font:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif}.ds-dark{background:var(--pine);padding:24px}.ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:.55em;min-height:56px;padding:0 24px;border-radius:999px;font:800 1.06rem/1.1 var(--font);text-decoration:none;cursor:pointer;border:2px solid transparent;transition:background-color .2s,border-color .2s,color .2s,transform .12s}.ds-btn:active{transform:scale(.98)}.ds-btn:focus-visible{outline:3px solid var(--gold);outline-offset:3px}.ds-btn-fill{background:var(--rust);color:#fff;border-color:var(--rust);box-shadow:0 8px 18px -10px rgba(8,20,14,.55)}.ds-btn-fill:hover{background:var(--rust-hi);border-color:var(--rust-hi)}"
    },
    {
